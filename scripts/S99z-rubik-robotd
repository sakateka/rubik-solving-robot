#!/bin/sh

DAEMON="/mnt/storage/rubik-robotd"
CONFIG="/mnt/storage/stand.toml"
PIDFILE="/var/run/rubik-robotd.pid"
LOG_FIFO="/var/run/rubik-robotd.log.fifo"
LOGGER_PIDFILE="/var/run/rubik-robotd.logger.pid"
STOP_TIMEOUT=30
RESTART_DELAY=2
START_CHECK_DELAY=1

# Vendor camera and TPU shared libraries from the stock Milk-V Duo image.
export LD_LIBRARY_PATH="/mnt/system/lib:/mnt/system/usr/lib:/mnt/system/usr/lib/3rd"

stop_logger() {
	if [ -r "$LOGGER_PIDFILE" ]; then
		logger_pid=$(cat "$LOGGER_PIDFILE")
		kill "$logger_pid" 2>/dev/null || true
	fi
	rm -f "$LOGGER_PIDFILE" "$LOG_FIFO"
}

start() {
	printf 'Starting rubik-robotd: '
	if [ ! -x "$DAEMON" ]; then
		echo "FAIL ($DAEMON is missing or not executable)"
		return 1
	fi
	if [ ! -r "$CONFIG" ]; then
		echo "FAIL ($CONFIG is missing or unreadable)"
		return 1
	fi
	if [ -r "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE")
		if kill -0 "$pid" 2>/dev/null; then
			echo "FAIL (already running, pid=$pid)"
			return 1
		fi
		rm -f "$PIDFILE"
	fi
	stop_logger
	if ! mkfifo "$LOG_FIFO"; then
		echo "FAIL (could not create $LOG_FIFO)"
		return 1
	fi
	logger -t rubik-robotd <"$LOG_FIFO" &
	logger_pid=$!
	if ! echo "$logger_pid" >"$LOGGER_PIDFILE"; then
		kill "$logger_pid" 2>/dev/null || true
		rm -f "$LOG_FIFO"
		echo "FAIL (could not write $LOGGER_PIDFILE)"
		return 1
	fi
	logger -t rubik-robotd "=== rubik-robotd start: $(date) ==="
	nohup "$DAEMON" --confirm-stand-motion --config "$CONFIG" \
		>"$LOG_FIFO" 2>&1 </dev/null &
	pid=$!
	if ! echo "$pid" >"$PIDFILE"; then
		kill "$pid" 2>/dev/null || true
		stop_logger
		echo "FAIL (could not write $PIDFILE)"
		return 1
	fi
	sleep "$START_CHECK_DELAY"
	if ! kill -0 "$pid" 2>/dev/null; then
		rm -f "$PIDFILE"
		stop_logger
		echo "FAIL (daemon exited; check syslog tag rubik-robotd)"
		return 1
	fi
	echo "OK (pid=$pid, syslog tag=rubik-robotd)"
}

stop() {
	printf 'Stopping rubik-robotd: '
	if [ ! -r "$PIDFILE" ]; then
		stop_logger
		echo "OK (not running)"
		return 0
	fi
	pid=$(cat "$PIDFILE")
	case "$pid" in
		''|*[!0-9]*)
			echo "FAIL (invalid PID file)"
			return 1
			;;
	esac
	if ! kill -0 "$pid" 2>/dev/null; then
		rm -f "$PIDFILE"
		stop_logger
		echo "OK (stale PID file removed)"
		return 0
	fi
	start-stop-daemon -K -q -p "$PIDFILE" -x "$DAEMON"
	status=$?
	if [ "$status" -ne 0 ]; then
		echo "FAIL"
		return "$status"
	fi

	waited=0
	while kill -0 "$pid" 2>/dev/null; do
		if [ "$waited" -ge "$STOP_TIMEOUT" ]; then
			echo "FAIL (still running after ${STOP_TIMEOUT}s)"
			return 1
		fi
		sleep 1
		waited=$((waited + 1))
	done
	rm -f "$PIDFILE"
	stop_logger
	echo "OK"
}

restart() {
	stop || return $?
	sleep "$RESTART_DELAY"
	start
}

status() {
	if [ ! -r "$PIDFILE" ]; then
		echo "rubik-robotd is stopped"
		return 3
	fi
	pid=$(cat "$PIDFILE")
	case "$pid" in
		''|*[!0-9]*)
			echo "rubik-robotd status is unknown (invalid PID file)"
			return 4
			;;
	esac
	if ! kill -0 "$pid" 2>/dev/null; then
		echo "rubik-robotd is stopped (stale PID file, pid=$pid)"
		return 1
	fi
	executable=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
	case "$executable" in
		"$DAEMON"|"$DAEMON (deleted)")
			echo "rubik-robotd is running (pid=$pid, syslog tag=rubik-robotd)"
			return 0
			;;
		*)
			echo "rubik-robotd status is unknown (pid=$pid belongs to $executable)"
			return 4
			;;
	esac
}

case "${1:-}" in
	start|stop|restart|status)
		"$1"
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
